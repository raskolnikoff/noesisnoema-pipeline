{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag.fish/schemas/ragpack-manifest-1.3.json",
  "title": "RAGpack manifest v1.3",
  "description": "Additive extension of v1.2. Readers MUST tolerate unknown fields. A pack missing the 'governance' block is treated as ungoverned (runtime labels answers accordingly under G1).",
  "type": "object",
  "required": ["ragpack_version", "pack_id", "created_at", "embedding", "integrity"],
  "properties": {
    "ragpack_version": { "const": "1.3" },
    "pack_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },

    "embedding": {
      "type": "object",
      "description": "Carried over from v1.2 (ADR-0011). Unchanged semantics.",
      "required": ["model_id", "dim", "normalization"],
      "properties": {
        "model_id": { "type": "string", "examples": ["nomic-embed-text-v1.5"] },
        "dim": { "type": "integer", "minimum": 1 },
        "normalization": { "enum": ["none", "mean_center"] },
        "centroid_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },

    "provenance": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "sha256", "license"],
            "properties": {
              "source_id": { "type": "string" },
              "uri": { "type": "string", "description": "Optional; omit for private documents. sha256 is the identity." },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "license": { "type": "string", "description": "SPDX id or 'proprietary' / 'internal'" },
              "retrieved_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },

    "governance": {
      "type": "object",
      "required": ["license_class", "retention", "promotion"],
      "properties": {
        "license_class": { "enum": ["internal", "open", "proprietary", "mixed"] },
        "retention": {
          "type": "object",
          "required": ["policy"],
          "properties": {
            "policy": { "type": "string", "pattern": "^(indefinite|days:[0-9]+)$" },
            "expires_at": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "promotion": {
          "type": "object",
          "required": ["status", "gate"],
          "properties": {
            "status": { "enum": ["candidate", "promoted", "rejected"] },
            "gate": { "const": "G3" },
            "policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "sha256 of the noema-policy.yaml used for the gate run" },
            "eval_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "recall_at_k": {
              "type": "object",
              "required": ["k", "value", "threshold"],
              "properties": {
                "k": { "type": "integer", "minimum": 1 },
                "value": { "type": "number", "minimum": 0, "maximum": 1 },
                "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "approved_by": { "type": "string", "description": "Human identifier. Required when status=promoted." },
            "approved_at": { "type": "string", "format": "date-time" }
          },
          "if": { "properties": { "status": { "const": "promoted" } } },
          "then": { "required": ["status", "gate", "policy_sha256", "eval_report_sha256", "recall_at_k", "approved_by", "approved_at"] }
        }
      }
    },

    "integrity": {
      "type": "object",
      "required": ["chunks_sha256", "embeddings_sha256"],
      "properties": {
        "chunks_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "sha256 of chunks file bytes" },
        "embeddings_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "sha256 of embeddings.npy bytes" },
        "manifest_signature": {
          "type": ["object", "null"],
          "description": "Optional Ed25519 detached signature over the canonical (RFC 8785) manifest with this field set to null.",
          "properties": {
            "alg": { "const": "ed25519" },
            "public_key": { "type": "string", "description": "base64" },
            "signature": { "type": "string", "description": "base64" }
          }
        }
      }
    }
  }
}
